---
import '@fontsource/ibm-plex-sans/400.css';
import '@fontsource/ibm-plex-sans/400-italic.css';
import '@fontsource/ibm-plex-sans/500.css';
import '@fontsource/ibm-plex-sans/600.css';
import '@fontsource/fira-code/400.css';
import '@fontsource/fira-code/500.css';
import '../styles/global.css';

import { AUTHOR, QUOTE, SITE_DESCRIPTION, SITE_TITLE } from '../consts';

interface Props {
  title?: string;
  description?: string;
  /** Which nav entry is the current section. */
  section?: 'posts' | 'projects' | 'about';
  type?: 'website' | 'article';
}

const { title, description = SITE_DESCRIPTION, section, type = 'website' } = Astro.props;
const fullTitle = title ? `${title} · ${AUTHOR}` : SITE_TITLE;
const canonical = new URL(Astro.url.pathname, Astro.site);

const nav = [
  { id: 'posts', href: '/', label: 'Posts' },
  { id: 'projects', href: '/projects/', label: 'Projects' },
  { id: 'about', href: '/about/', label: 'About' },
] as const;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light dark" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="alternate" type="application/rss+xml" title={SITE_TITLE} href="/rss.xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta property="og:type" content={type} />
    <meta property="og:title" content={title ?? SITE_TITLE} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta name="generator" content={Astro.generator} />
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <div class="wrap page">
      <header class="site-header">
        <a class="brand" href="/">dennis<span>/</span>log</a>
        <nav aria-label="Main">
          {
            nav.map((item) => (
              <a href={item.href} aria-current={section === item.id ? 'page' : undefined}>
                {item.label}
              </a>
            ))
          }
          <a href="/rss.xml">RSS</a>
        </nav>
      </header>

      <main id="main">
        <slot />
      </main>

      <footer class="site-footer">
        <span>{QUOTE}</span>
        <span>static · markdown · deployed from main</span>
      </footer>
    </div>
  </body>
</html>

<style>
  .page {
    display: flex;
    flex-direction: column;
    gap: 56px;
    min-height: 100vh;
    padding-block: 40px 64px;
  }

  main {
    flex: 1;
  }

  .skip {
    position: absolute;
    left: 16px;
    top: -48px;
    padding: 8px 12px;
    background: var(--fg);
    color: var(--bg);
    border-radius: 4px;
    z-index: 1;
  }

  .skip:focus {
    top: 12px;
    color: var(--bg);
  }

  .site-header {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: 12px 24px;
    padding-bottom: 20px;
    border-bottom: 1px solid var(--line);
  }

  .brand {
    font-family: var(--mono);
    font-variant-ligatures: none;
    font-size: 15px;
    font-weight: 500;
  }

  .brand span {
    color: var(--accent);
  }

  nav {
    display: flex;
    flex-wrap: wrap;
    gap: 6px 24px;
    font-size: 14px;
  }

  nav a {
    color: var(--subtle);
  }

  nav a:hover {
    color: var(--accent);
  }

  nav a[aria-current='page'] {
    color: var(--fg);
    font-weight: 500;
  }

  .site-footer {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 8px 24px;
    padding-top: 20px;
    border-top: 1px solid var(--line);
    font-family: var(--mono);
    font-variant-ligatures: none;
    font-size: 12px;
    color: var(--subtle);
  }
</style>
