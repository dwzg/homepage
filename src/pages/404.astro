---
import Base from '../layouts/Base.astro';
---

<Base title="Not found">
  <div class="missing">
    <p class="label">404</p>
    <h1>There is nothing at this address.</h1>
    <p>It may have moved. <a href="/">All posts</a> are on the front page.</p>
  </div>
</Base>

<style>
  .missing {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  h1 {
    margin: 0;
    font-size: 28px;
    font-weight: 600;
  }

  p {
    margin: 0;
    color: var(--muted);
  }

  a {
    color: var(--accent);
  }
</style>
