---
import { render } from 'astro:content';

import Base from '../../layouts/Base.astro';
import { AUTHOR } from '../../consts';
import { getProject } from '../../data/projects';
import { getPosts, isoDate, readingMinutes, type Post } from '../../lib/posts';

export async function getStaticPaths() {
  const posts = await getPosts();
  // Newest first, so the neighbour at i + 1 is the older post.
  return posts.map((post, i) => ({
    params: { slug: post.id },
    props: { post, older: posts[i + 1], newer: posts[i - 1] },
  }));
}

interface Props {
  post: Post;
  older?: Post;
  newer?: Post;
}

const { post, older, newer } = Astro.props;
const { Content, headings } = await render(post);
const project = getProject(post.data.project);
const toc = headings.filter((h) => h.depth === 2);
---

<Base title={post.data.title} description={post.data.summary} section="posts" type="article">
  <div class="post">
    <aside class="meta">
      <div class="field">
        <span class="label">Published</span>
        <time class="mono" datetime={post.data.date.toISOString()}>{isoDate(post.data.date)}</time>
      </div>
      {
        post.data.updated && (
          <div class="field">
            <span class="label">Updated</span>
            <time class="mono" datetime={post.data.updated.toISOString()}>
              {isoDate(post.data.updated)}
            </time>
          </div>
        )
      }
      <div class="field">
        <span class="label">Project</span>
        <a class="mono accent" href={`/projects/${project.id}/`}>{project.name}</a>
        {project.repo && <a class="repo" href={project.repo}>Source on GitHub</a>}
      </div>
      <div class="field">
        <span class="label">Reading time</span>
        <span>{readingMinutes(post.body)} min</span>
      </div>
      {
        post.data.assisted && (
          <div class="field note">
            <span class="label">Written with Claude</span>
            <span>
              Drafted by Claude from the project's commit history and notes, then reviewed by{' '}
              {AUTHOR}.
            </span>
          </div>
        )
      }
      {
        toc.length > 1 && (
          <nav class="field toc" aria-label="On this page">
            <span class="label">On this page</span>
            {toc.map((h) => <a href={`#${h.slug}`}>{h.text}</a>)}
          </nav>
        )
      }
    </aside>

    <article>
      <header>
        <h1>{post.data.title}</h1>
        <p class="summary">{post.data.summary}</p>
      </header>
      <div class="prose">
        <Content />
      </div>
    </article>
  </div>

  {
    (older || newer) && (
      <nav class="pager" aria-label="More posts">
        {older ? <a href={`/posts/${older.id}/`}>← {older.data.title}</a> : <span />}
        {newer && <a href={`/posts/${newer.id}/`}>{newer.data.title} →</a>}
      </nav>
    )
  }
</Base>

<style>
  .post {
    display: flex;
    flex-wrap: wrap;
    gap: 40px 64px;
    align-items: flex-start;
  }

  .meta {
    flex: 1 1 200px;
    max-width: 240px;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 18px;
    font-size: 13px;
    line-height: 1.5;
    color: var(--text);
  }

  .field {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .accent {
    color: var(--accent);
  }

  .repo {
    color: var(--muted);
  }

  .note {
    gap: 6px;
    padding: 12px;
    background: var(--surface);
    border-radius: 6px;
    color: var(--muted);
  }

  .toc {
    gap: 6px;
  }

  .toc a {
    color: var(--muted);
  }

  .toc a:hover {
    color: var(--accent);
  }

  article {
    flex: 999 1 560px;
    min-width: 0;
    max-width: var(--prose);
    display: flex;
    flex-direction: column;
    gap: 28px;
  }

  header {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  h1 {
    margin: 0;
    font-size: clamp(30px, 4.4vw, 38px);
    line-height: 1.15;
    font-weight: 600;
    letter-spacing: -0.02em;
    text-wrap: balance;
  }

  .summary {
    margin: 0;
    font-size: 19px;
    line-height: 1.55;
    color: var(--muted);
  }

  .pager {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 12px 24px;
    margin-top: 56px;
    padding-top: 20px;
    border-top: 1px solid var(--line);
    font-size: 14px;
    color: var(--accent);
  }

  /* On a narrow screen the sidebar becomes a compact strip above the post. */
  @media (max-width: 860px) {
    .post {
      gap: 28px;
    }

    .meta {
      max-width: none;
      flex-direction: row;
      flex-wrap: wrap;
      gap: 14px 28px;
      padding-bottom: 20px;
      border-bottom: 1px solid var(--line);
    }

    .note {
      flex: 1 1 100%;
    }

    .toc {
      display: none;
    }
  }
</style>
